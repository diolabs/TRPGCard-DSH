{
  "name": "trpgcard",
  "version": "0.1.1",
  "type": "module",
  "description": "在 DeepSeek Harness 中使用现有 TRPGCard 主持人页面与工具",
  "homepage": "https://github.com/diolabs/TRPGCard-DSH#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diolabs/TRPGCard-DSH.git"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.host.js",
    "./remote": "./lib/typert.remote-client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "engines": {
    "dsh": "0.2.2-rc.5",
    "node": ">=24.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-api-gateway": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.5",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.5",
    "@deepseek-ai/dsh-error": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "3.19.0",
    "react": "18.3.1",
    "zod": "4.6.6"
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "README.md"
  ]
}
